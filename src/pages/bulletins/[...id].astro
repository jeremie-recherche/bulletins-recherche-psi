---
import { getCollection, render } from 'astro:content';
import BulletinLayout from '../../layouts/BulletinLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('bulletins', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const editUrl = `https://github.com/jeremie-recherche/bulletins-recherche-psi/edit/main/src/content/bulletins/${post.id}.md`;
---

<BulletinLayout data={post.data} editUrl={editUrl}><Content /></BulletinLayout>
